 * Source: derived/bindings.yaml（kafka transport 段）
 * 协议：{PROTOCOL_NAME} v{PROTOCOL_VERSION}
 *
 * 写入位置：<implRoot>/clients/kafka.ts
 * 不要手改；改 bindings.yaml → 重新跑 `protochain generate-scaffold --lang=ts`。
 *
 * 依赖：kafkajs（已登记于 package.json dependencies）
 */

import { Kafka, type Producer, type Consumer, type EachMessagePayload, logLevel } from 'kafkajs';

// ============================================================================
// 类型
// ============================================================================

export interface KafkaBinding {
  action: string;
  roleId: string;
  topic: string;
  keyField?: string;
  serde: 'json' | 'avro' | 'protobuf';
  timeoutMs?: number;
  responseMode: 'none' | 'reply_topic' | 'poll';
  responseTopic?: string;
  correlationIdField?: string;
}

export interface KafkaRoleConfig {
  /** brokersEnv：环境变量名（解耦 secret 进代码） */
  brokersEnv: string;
  consumerGroup?: string;
  sasl?: {
    mechanism: 'plain' | 'scram-sha-256' | 'scram-sha-512';
    usernameEnv: string;
    passwordEnv: string;
  };
}

export interface KafkaClientConfig {
  /** bindings.yaml 的 roles 段（kafka 角色） */
  roles: Record<string, KafkaRoleConfig>;
  bindings: KafkaBinding[];
  protocolName: string;
  protocolVersion: string;
}

// ============================================================================
// KafkaClient
// ============================================================================

export class KafkaClient {
  private readonly kafkaByRole = new Map<string, Kafka>();
  private readonly producerByRole = new Map<string, Producer>();

  constructor(private readonly config: KafkaClientConfig) {}

  listActions(): string[] {
    return this.config.bindings.map((b) => b.action).sort();
  }

  /**
    * 发送一条 kafka 消息（fire-and-forget；responseMode='none' 时直接返回）。
    * payload 必含 keyField（若声明）；correlationIdField（若声明）。
    */
  async send(action: string, payload: Record<string, unknown>): Promise<{ ack: true; topic: string; offset?: string }> {
    const binding = this.config.bindings.find((b) => b.action === action);
    if (!binding) {
      throw new Error(`未注册 action: ${action}（bindings.yaml 缺该接口）`);
    }
    const producer = await this.ensureProducer(binding.roleId);
    const message = this.serialize(binding, payload);
    const meta = await producer.send({
      topic: binding.topic,
      messages: [message],
      timeout: binding.timeoutMs ?? 30000,
    });
    const first = meta[0];
    return {
      ack: true,
      topic: binding.topic,
      offset: first ? String(first.baseOffset ?? '') : undefined,
    };
  }

  /**
    * 订阅消费：用于 reply_topic / poll 模式拿响应消息；impl 业务层负责反序列化。
    * 不阻塞消费；返回 consumer 让业务 close。
    */
  async subscribe(
    action: string,
    handler: (msg: EachMessagePayload) => Promise<void> | void
  ): Promise<Consumer> {
    const binding = this.config.bindings.find((b) => b.action === action);
    if (!binding) {
      throw new Error(`未注册 action: ${action}（bindings.yaml 缺该接口）`);
    }
    if (binding.responseMode === 'none') {
      throw new Error(`action=${action} responseMode=none，不支持订阅响应`);
    }
    const role = this.config.roles[binding.roleId];
    if (!role) throw new Error(`bindings.roles 缺 roleId=${binding.roleId}`);
    const kafka = this.kafkaFor(binding.roleId);
    const consumer = kafka.consumer({ groupId: role.consumerGroup ?? `protochain-${binding.roleId}` });
    await consumer.connect();
    const topic = binding.responseTopic ?? binding.topic;
    await consumer.subscribe({ topic, fromBeginning: false });
    await consumer.run({ eachMessage: handler });
    this.bindingsByRole(binding.roleId).consumers.push(consumer);
    return consumer;
  }

  async close(): Promise<void> {
    for (const producer of this.producerByRole.values()) {
      try { await producer.disconnect(); } catch { /* 忽略 */ }
    }
    for (const roleId of this.bindingsByRole_list()) {
      const consumers = this.bindingsByRole(roleId).consumers;
      for (const c of consumers) {
        try { await c.disconnect(); } catch { /* 忽略 */ }
      }
    }
    this.producerByRole.clear();
  }

  private serialize(binding: KafkaBinding, payload: Record<string, unknown>) {
    let value: Buffer;
    if (binding.serde === 'json') {
      value = Buffer.from(JSON.stringify(payload), 'utf-8');
    } else {
      // avro/protobuf 留作扩展锚点；当前统一转 JSON 字符串，由 impl 自行编码
      value = Buffer.from(JSON.stringify(payload), 'utf-8');
    }
    const key = binding.keyField
      ? Buffer.from(String(payload[binding.keyField] ?? ''), 'utf-8')
      : null;
    return { key, value };
  }

  private async ensureProducer(roleId: string): Promise<Producer> {
    let producer = this.producerByRole.get(roleId);
    if (producer) return producer;
    const kafka = this.kafkaFor(roleId);
    producer = kafka.producer({ allowAutoTopicCreation: false });
    await producer.connect();
    this.producerByRole.set(roleId, producer);
    return producer;
  }

  private kafkaFor(roleId: string): Kafka {
    let kafka = this.kafkaByRole.get(roleId);
    if (kafka) return kafka;
    const role = this.config.roles[roleId];
    if (!role) throw new Error(`bindings.roles 缺 roleId=${roleId}`);
    const brokers = (process.env[role.brokersEnv] ?? '').split(',').filter(Boolean);
    if (brokers.length === 0) {
      throw new Error(`环境变量 ${role.brokersEnv} 未设置或为空`);
    }
    kafka = new Kafka({
      clientId: `protochain-${this.config.protocolName}-${roleId}`,
      brokers,
      logLevel: logLevel.WARN,
      ...(role.sasl
        ? {
            ssl: true,
            sasl: {
              mechanism: role.sasl.mechanism,
              username: process.env[role.sasl.usernameEnv] ?? '',
              password: process.env[role.sasl.passwordEnv] ?? '',
            },
          }
        : {}),
    });
    this.kafkaByRole.set(roleId, kafka);
    return kafka;
  }

  /** 内部：每个 role 的 consumer 列表（close 时统一断开） */
  private bindingsByRole(roleId: string): { consumers: Consumer[] } {
    if (!this._consumersByRole.has(roleId)) this._consumersByRole.set(roleId, []);
    return { consumers: this._consumersByRole.get(roleId)! };
  }
  private _consumersByRole = new Map<string, Consumer[]>();
  private bindingsByRole_list(): string[] {
    return Array.from(this._consumersByRole.keys());
  }
}