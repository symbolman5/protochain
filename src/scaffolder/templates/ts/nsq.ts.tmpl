import { Writer, Reader, type Message } from 'nsqjs';

// ============================================================================
// 类型
// ============================================================================

export interface NsqBinding {
  action: string;
  roleId: string;
  topic: string;
  channel?: string;
  serde: 'json';
  timeoutMs?: number;
  responseMode: 'none' | 'reply_topic' | 'poll';
  responseTopic?: string;
  correlationIdField?: string;
}

export interface NsqRoleConfig {
  /** nsqdTcpEnv：环境变量名（解耦 secret 进代码） */
  nsqdTcpEnv: string;
  nsqlookupdHttpEnv?: string;
  responseTimeoutMs?: number;
}

export interface NsqClientConfig {
  roles: Record<string, NsqRoleConfig>;
  bindings: NsqBinding[];
  protocolName: string;
  protocolVersion: string;
}

// ============================================================================
// NsqClient
// ============================================================================

export class NsqClient {
  private readonly writerByRole = new Map<string, Writer>();

  constructor(private readonly config: NsqClientConfig) {}

  listActions(): string[] {
    return this.config.bindings.map((b) => b.action).sort();
  }

  /** 发布一条消息；JSON 序列化 */
  async publish(action: string, payload: Record<string, unknown>): Promise<{ ack: true; topic: string }> {
    const binding = this.config.bindings.find((b) => b.action === action);
    if (!binding) {
      throw new Error(`未注册 action: ${action}（bindings.yaml 缺该接口）`);
    }
    const writer = await this.ensureWriter(binding.roleId);
    const body = Buffer.from(JSON.stringify(payload), 'utf-8');
    await writer.publish(binding.topic, body);
    return { ack: true, topic: binding.topic };
  }

  /**
   * 订阅消费：reader 模式（NSQ 推荐 pull 消费；handler 接 nsqjs Message）。
   * channel 默认取 bindings.yaml 配置；未配置取 `protochain-{action}`。
   */
  async subscribe(
    action: string,
    handler: (msg: Message) => Promise<void> | void
  ): Promise<Reader> {
    const binding = this.config.bindings.find((b) => b.action === action);
    if (!binding) {
      throw new Error(`未注册 action: ${action}（bindings.yaml 缺该接口）`);
    }
    const role = this.config.roles[binding.roleId];
    if (!role) throw new Error(`bindings.roles 缺 roleId=${binding.roleId}`);
    const nsqdTcp = (process.env[role.nsqdTcpEnv] ?? '').split(',').filter(Boolean);
    if (nsqdTcp.length === 0) {
      throw new Error(`环境变量 ${role.nsqdTcpEnv} 未设置或为空`);
    }
    const channel = binding.channel ?? `protochain-${binding.action}`;
    const reader = new Reader(binding.topic, channel, {
      nsqdTCPAddresses: nsqdTcp,
      ...(process.env[role.nsqlookupdHttpEnv ?? '']
        ? { lookupdHTTPAddresses: (process.env[role.nsqlookupdHttpEnv ?? ''] ?? '').split(',').filter(Boolean) }
        : {}),
      maxInFlight: 1,
    });
    reader.on('message', (msg) => {
      Promise.resolve(handler(msg))
        .then(() => msg.finish())
        .catch((err) => msg.requeue(Number(err?.retries ?? 1)));
    });
    await reader.connect();
    this.readersByRole(binding.roleId).push(reader);
    return reader;
  }

  async close(): Promise<void> {
    for (const writer of this.writerByRole.values()) {
      try { await writer.close(); } catch { /* 忽略 */ }
    }
    for (const readers of this.readersByRole_map().values()) {
      for (const r of readers) {
        try { await r.close(); } catch { /* 忽略 */ }
      }
    }
    this.writerByRole.clear();
  }

  private async ensureWriter(roleId: string): Promise<Writer> {
    let writer = this.writerByRole.get(roleId);
    if (writer) return writer;
    const role = this.config.roles[roleId];
    if (!role) throw new Error(`bindings.roles 缺 roleId=${roleId}`);
    const nsqdTcp = (process.env[role.nsqdTcpEnv] ?? '').split(',').filter(Boolean);
    if (nsqdTcp.length === 0) {
      throw new Error(`环境变量 ${role.nsqdTcpEnv} 未设置或为空`);
    }
    writer = new Writer(nsqdTcp);
    await writer.connect();
    this.writerByRole.set(roleId, writer);
    return writer;
  }

  // readers 状态
  private _readersByRole = new Map<string, Reader[]>();
  private readersByRole(roleId: string): Reader[] {
    if (!this._readersByRole.has(roleId)) this._readersByRole.set(roleId, []);
    return this._readersByRole.get(roleId)!;
  }
  private readersByRole_map() { return this._readersByRole; }
}

// ============================================================================
// E5 验证辅助：与 http.ts 同形态，便于统一 verify
// ============================================================================

export interface NsqActionNames {
  clientActions: string[];
  bindingActions: string[];
}

export function diffNsqActionNames(c: NsqActionNames): { missing: string[]; extra: string[] } {
  const cs = new Set(c.clientActions);
  const bs = new Set(c.bindingActions);
  return {
    missing: c.bindingActions.filter((a) => !cs.has(a)),
    extra: c.clientActions.filter((a) => !bs.has(a)),
  };
}