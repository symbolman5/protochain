/**
 * Auto-generated by protochain E5 scaffolder（generate-scaffold --lang=ts）。
 * Source: derived/bindings.yaml（E3 骨架 + 人工填写 baseUrl/headers/authConfig）。
 * 协议：{PROTOCOL_NAME} v{PROTOCOL_VERSION}
 *
 * 写入位置：<implRoot>/clients/http.ts
 * 不要手改；改 bindings.yaml → 重新跑 `protochain generate-scaffold --lang=ts`。
 *
 * 约束：
 *  - 仅封装 transport：method/path/params 序列化、错误归一化、auth 注入。
 *  - 业务语义（守卫、状态机、副作用）由 impl 业务层负责。
 *  - 依赖：fetch（Node 18+ 全局可用；如需 polyfill 改 import {fetch} from 'undici'）。
 */

// ============================================================================
// 类型与共享工具
// ============================================================================

export interface HttpBinding {
  /** 逻辑接口名（= bindings.yaml interfaces[].action；与 specs.json 同名） */
  action: string;
  /** 角色 ID（与 bindings.yaml interfaces[].roleId 对齐） */
  roleId: string;
  method: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';
  path: string;
  /** params 顺序：path → query → header → body */
  params: Array<{
    logicalName: string;
    in: 'path' | 'query' | 'body' | 'header';
    physicalName?: string;
  }>;
}

export interface RoleConfig {
  baseUrl: string;
  auth?: 'none' | 'bearer' | 'basic' | 'hmac' | 'api_key' | 'mtls';
  authConfig?: {
    tokenEnv?: string;
    usernameEnv?: string;
    passwordEnv?: string;
    headerName?: string;
    keyEnv?: string;
  };
  headers?: Record<string, string>;
}

export interface HttpClientConfig {
  /** bindings.yaml 的 roles 段 */
  roles: Record<string, RoleConfig>;
  /** bindings.yaml 的 interfaces 段（已按 --protocol 过滤） */
  bindings: HttpBinding[];
  /** 协议名（仅日志用） */
  protocolName: string;
  protocolVersion: string;
  /** 可选：fetch 超时（ms），默认 30000 */
  timeoutMs?: number;
}

export interface HttpResponse<T = unknown> {
  status: number;
  ok: boolean;
  data?: T;
  raw: Response;
}

export class HttpError extends Error {
  readonly status: number;
  readonly body?: unknown;
  constructor(status: number, message: string, body?: unknown) {
    super(`HTTP ${status}: ${message}`);
    this.name = 'HttpError';
    this.status = status;
    this.body = body;
  }
}

// ============================================================================
// HttpClient
// ============================================================================

export class HttpClient {
  private readonly bindingsByAction: Map<string, HttpBinding>;

  constructor(private readonly config: HttpClientConfig) {
    this.bindingsByAction = new Map();
    for (const b of config.bindings) {
      this.bindingsByAction.set(b.action, b);
    }
  }

  /**
   * 列出全部已知 action（用于 verify 时与 bindings.yaml 100% 对齐核对）
   */
  listActions(): string[] {
    return Array.from(this.bindingsByAction.keys()).sort();
  }

  /**
   * 通用调用：按 action 查 binding，按 params 序列化 → fetch。
   * impl 业务层只关心 body/返回；transport 细节全在这层。
   */
  async invoke<T = unknown>(
    action: string,
    args: Record<string, unknown> = {}
  ): Promise<HttpResponse<T>> {
    const binding = this.bindingsByAction.get(action);
    if (!binding) {
      throw new HttpError(0, `未注册 action: ${action}（bindings.yaml 缺该接口）`);
    }
    const role = this.config.roles[binding.roleId];
    if (!role) {
      throw new HttpError(0, `bindings.roles 缺 roleId=${binding.roleId}`);
    }
    const { url, init } = this.buildRequest(binding, role, args);
    return this.execute<T>(url, init, action);
  }

  /**
   * 构造 fetch 入参（path 替换、query 编码、body 序列化、auth header 注入）。
   * 暴露此方法便于测试断言"生成的 URL/init 与 bindings 一致"。
   */
  buildRequest(
    binding: HttpBinding,
    role: RoleConfig,
    args: Record<string, unknown>
  ): { url: string; init: RequestInit } {
    let path = binding.path;
    const headers: Record<string, string> = { ...(role.headers ?? {}) };
    const query = new URLSearchParams();
    let body: unknown = undefined;

    for (const p of binding.params) {
      const v = args[p.logicalName];
      const name = p.physicalName ?? p.logicalName;
      switch (p.in) {
        case 'path': {
          if (v === undefined || v === null) {
            throw new HttpError(0, `path 参数 ${p.logicalName} 缺失`);
          }
          path = path.replace(`{${name}}`, encodeURIComponent(String(v)));
          break;
        }
        case 'query': {
          if (v !== undefined && v !== null) query.append(name, String(v));
          break;
        }
        case 'header': {
          if (v !== undefined && v !== null) headers[name] = String(v);
          break;
        }
        case 'body': {
          if (body === undefined) body = {} as Record<string, unknown>;
          if (v !== undefined && v !== null) {
            (body as Record<string, unknown>)[name] = v;
          }
          break;
        }
      }
    }

    // auth 注入（从 env 读取 token；缺则报 HTTP 0）
    this.applyAuth(role, headers);

    const baseUrl = role.baseUrl.replace(/\/$/, '');
    const qs = query.toString();
    const url = qs ? `${baseUrl}${path}?${qs}` : `${baseUrl}${path}`;

    const init: RequestInit = {
      method: binding.method,
      headers: { 'Content-Type': 'application/json', ...headers },
    };
    if (binding.method !== 'GET' && binding.method !== 'DELETE' && body !== undefined) {
      init.body = JSON.stringify(body);
    }
    return { url, init };
  }

  /** 错误归一化：HTTP 4xx/5xx 抛 HttpError（保留 status + body） */
  private async execute<T>(url: string, init: RequestInit, action: string): Promise<HttpResponse<T>> {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), this.config.timeoutMs ?? 30000);
    init.signal = ctrl.signal;
    let resp: Response;
    try {
      resp = await fetch(url, init);
    } catch (err) {
      clearTimeout(timer);
      throw new HttpError(0, `transport failure: ${err instanceof Error ? err.message : String(err)}`);
    }
    clearTimeout(timer);

    let data: unknown = undefined;
    const ct = resp.headers.get('content-type') ?? '';
    if (ct.includes('application/json')) {
      try {
        data = await resp.json();
      } catch {
        // 忽略 JSON 解析失败（保持 raw）
      }
    } else {
      try {
        data = await resp.text();
      } catch {
        // 忽略
      }
    }

    if (!resp.ok) {
      throw new HttpError(resp.status, `action=${action} ${resp.statusText}`, data);
    }
    return { status: resp.status, ok: true, data: data as T | undefined, raw: resp };
  }

  private applyAuth(role: RoleConfig, headers: Record<string, string>): void {
    const auth = role.auth ?? 'none';
    const cfg = role.authConfig ?? {};
    if (auth === 'bearer' && cfg.tokenEnv) {
      const token = process.env[cfg.tokenEnv];
      if (token) headers['Authorization'] = `Bearer ${token}`;
    } else if (auth === 'api_key' && cfg.keyEnv) {
      const key = process.env[cfg.keyEnv];
      const name = cfg.headerName ?? 'X-API-Key';
      if (key) headers[name] = key;
    } else if (auth === 'basic' && cfg.usernameEnv && cfg.passwordEnv) {
      const u = process.env[cfg.usernameEnv] ?? '';
      const p = process.env[cfg.passwordEnv] ?? '';
      if (u || p) {
        headers['Authorization'] = `Basic ${Buffer.from(`${u}:${p}`).toString('base64')}`;
      }
    }
  }
}

// ============================================================================
// E5 验证辅助：bindings → method 名一致检查（run 端无需关注）
// ============================================================================

/**
 * 在 verify 启动时调用一次，确保 http.ts 与 bindings.yaml 100% 一致：
 *  - 生成的 action 名 ⊇ bindings.actions（生成不能少；多了即无 binding，verify 拒）
 * 实际生产代码不会用；这里作为 generate-scaffold 的"模板完整性检查"约束锚点。
 */
export function diffActionNames(
  clientActions: string[],
  bindingActions: string[]
): { missing: string[]; extra: string[] } {
  const cs = new Set(clientActions);
  const bs = new Set(bindingActions);
  return {
    missing: bindingActions.filter((a) => !cs.has(a)),
    extra: clientActions.filter((a) => !bs.has(a)),
  };
}