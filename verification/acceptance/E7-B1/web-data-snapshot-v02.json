  "dependencyGraph": {
    "mermaid": "graph LR\n  P1[转发服务器管理]\n  P2[用户管理]\n  P3[内网映射域]\n  P4[文件托管域]\n  P2 -.公共基础协议.-> P1\n  P2 -.公共基础协议.-> P3\n  P2 -.公共基础协议.-> P4\n  P1 -.入口宿主.-> P3\n  P3 -.域名基质共享.-> P4\n  P1 -.证书池语义复用.-> P4",
    "edges": [
      {
        "from": "P2",
        "to": "P1",
        "dependencyType": "state",
        "description": "P1 所有写操作（注册/上线/停用/注销）的守卫依赖 P2 账户处于活跃态且存在有效会话；P2 为公共基础协议"
      },
      {
        "from": "P2",
        "to": "P3",
        "dependencyType": "state",
        "description": "P3 所有写操作（域名 claim/映射创建与管理/端点管理/绑定/install secret 轮换）的守卫依赖 P2 账户处于活跃态且存在有效会话"
      },
      {
        "from": "P1",
        "to": "P3",
        "dependencyType": "state",
        "description": "P3 映射入口复用 P1 管理的节点（server，S2+ 在线）与网卡入口（公网 IP 作为 entry_ip）；server 注销前置检查 P3 非删除态映射引用"
      },
      {
        "from": "P2",
        "to": "P4",
        "dependencyType": "state",
        "description": "P4 全部管理操作（站点创建/上传签名/commit/停用/启用/删除/列表/详情/测试清理）的守卫依赖 P2 账户处于活跃态且存在有效会话（无 register 式机器面例外）；P2 为公共基础协议"
      },
      {
        "from": "P3",
        "to": "P4",
        "dependencyType": "state",
        "description": "P4 站点域名绑定复用 P3 域名基质（domain_pool/user_domains）并共享 fqdn_registry 统一 FQDN 台账——同一 FQDN 只能属于映射或托管站点之一（互斥）；P4 解绑删台账释放 FQDN，P4 软删保留台账行不复用；P3 随机二级域名分配保留，P4 在迭代 24 移除随机分配不影响 P3"
      },
      {
        "from": "P1",
        "to": "P4",
        "dependencyType": "state",
        "description": "P4 站点公开读 TLS 复用 P1 证书池导入仓库语义——站点域名（含通配 *.root）证书由管理员经 POST /v1/certs/import 导入登记；P4 不依赖 P1 节点/网卡（对象存储网关承载入口）"
      }
    ]
  },
